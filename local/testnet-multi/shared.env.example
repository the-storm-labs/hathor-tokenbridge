# Settings shared by all three federators: Arbitrum Sepolia (421614) + Hathor testnet, 2-of-3.
# Copy to shared.env (gitignored - the RPC URLs carry an API key) and fill the blanks after the
# contracts are deployed. Per-federator secrets live in fedN.identity.env, never here.
# No quotes around values: compose's env_file takes everything after `=` literally enough.

# ---- EVM chain: Bridge / Federation / AllowTokens ----
EVM_NAME=arbitrum-sepolia
EVM_CHAIN_ID=421614
# NOT sepolia-rollup.arbitrum.io: it does not implement eth_syncing, which both EVM readers call
# every run, so they fail every time. publicnode answers it and serves the 450-block log pages.
EVM_HOST=https://arbitrum-sepolia-rpc.publicnode.com
EVM_BRIDGE_ADDRESS=
EVM_FEDERATION_ADDRESS=
EVM_ALLOW_TOKENS_ADDRESS=
# The block the Bridge proxy was deployed at.
EVM_FROM_BLOCK=
# Arbitrum's ~0.25s blocks. The 15000 default is an L1 number.
EVM_BLOCK_TIME_MS=250

# ---- State chain: HathorFederation, on the same chain as in production ----
STATE_CHAIN_ID=421614
STATE_CHAIN_HOST=https://arbitrum-sepolia-rpc.publicnode.com
STATE_CONTRACT_ADDRESS=
STATE_FROM_BLOCK=
STATE_CONFIRMATION_BLOCKS=4

# ---- Hathor testnet ----
HATHOR_NAME=hathor
HATHOR_CHAIN_ID=31
HATHOR_NETWORK=testnet
HATHOR_FULLNODE_URL=https://node1.testnet.hathor.network/v1a/
HATHOR_TX_MINING_URL=https://txmining.testnet.hathor.network/

# The 2-of-3 multisig, generated 2026-09-21. Order matters: it is the order HATHOR_MULTISIG_ORDER
# indexes. Its receiving address (index 0) is wbihDnF11dfeMRVAWtE6b3MCCy9eSPoi5p - see public.json.
HATHOR_MULTISIG_PUBKEYS=xpub6CqonxbmvMch8xZ4cnbprzyBiiFJtGc3E1JDme31HHMyXqqeH99yqrTpd15yv9nBM6ogJjSbSeTnydaJqTftjyM39AgaRPEbPfQG7kCA35f,xpub6C426L9s6QfCwU7n65BQTLnUUoNG46XFmkQhFffYKnmo7niLQMTmhQ1vN228dNgZ6pbDRSAE2ePARZ9Qy1YenkFi2MCELjDg6ZxboSo6Eo1,xpub6BuDjem7Tfe5idXhKBFYkq2gZuAMz4B9Gop3xpQrAk8FzchcHZ52FuGgTfaAPWdAmMjUmdWYhamy2nMmp5eWw8FbC2XvZxv18WZQ9hGKTvR
HATHOR_NUM_SIGNATURES=2
HATHOR_MIN_CONFIRMATIONS=1
HATHOR_INPUT_LOCK_TTL_MS=1800000
# The multisig did not exist before this, so nothing earlier can concern it.
HATHOR_FROM_TIMESTAMP=1790000000

# ---- Runtime ----
LOG_LEVEL=debug
