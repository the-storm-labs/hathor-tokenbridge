// Replaces the old prometheus + promtail sidecar pair for this federator instance with a
// single Grafana Alloy agent that scrapes/tails locally and pushes both metrics and logs
// straight to Grafana Cloud - no inbound port needs to be exposed on this host anymore.
//
// Required env vars (put these in this federator's environments/<name>/<file>.env, same
// place FEDERATOR_KEY etc. already live):
//   GRAFANA_CLOUD_PROMETHEUS_URL   e.g. https://prometheus-prod-XX-prod-xx-x.grafana.net/api/prom/push
//   GRAFANA_CLOUD_PROMETHEUS_USER  the numeric Prometheus instance ID for your Grafana Cloud stack
//   GRAFANA_CLOUD_LOKI_URL         e.g. https://logs-prod-XXX.grafana.net/loki/api/v1/push
//   GRAFANA_CLOUD_LOKI_USER        the numeric Loki instance ID for your Grafana Cloud stack
//   GRAFANA_CLOUD_API_KEY          a Cloud Access Policy token scoped to metrics:write + logs:write
//                                  (Grafana Cloud -> your stack -> "Connections" page has all five
//                                  values ready to copy; the Loki ones are the exact same
//                                  credentials the old promtail-config_fed0N.yaml already used)
//   HATHOR_MULTISIG_ORDER          already set for every federator - reused here to label which
//                                  instance a given metric/log line came from
//
// Validated against the real `grafana/alloy` binary (v1.19.0) with `alloy validate` and a live
// `alloy run` (component graph evaluates, all 4 components report healthy, remote_write attempts
// real delivery) - see the PR description for details. Not yet run against real Grafana Cloud
// credentials.

// ---- metrics: same target/job the old prometheus.yml scraped, pushed instead of pulled ----
prometheus.scrape "federator" {
	targets = [{
		__address__ = "hathor-federator:5000",
	}]
	metrics_path    = "/metrics"
	job_name        = "federator"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}

	external_labels = {
		instance = "fed0" + sys.env("HATHOR_MULTISIG_ORDER"),
	}
}

// ---- logs: same file the old promtail-config_fed0N.yaml tailed ----
loki.source.file "federator" {
	targets = [{
		__address__ = "hathor-federator:5000",
		__path__    = "/var/log/*.log",
		job         = "federator-0" + sys.env("HATHOR_MULTISIG_ORDER"),
	}]
	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}

	external_labels = {
		instance = "fed0" + sys.env("HATHOR_MULTISIG_ORDER"),
	}
}
