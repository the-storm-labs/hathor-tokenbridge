HATHOR_NAME="golf"
HATHOR_CHAIN_ID=31
HATHOR_MULTISIG_ORDER=1
HATHOR_MINIMUM_CONFIRMATIONS=1
FEDERATOR_KEY=
ETHERSCAN_KEY=
EVM_NETWORK="sepolia"
BRIDGE_ADDRESS=""
FEDERATION_ADDRESS=""
ALLOW_TOKENS_ADDRESS=""
EVM_CHAIN_ID=11155111
EVM_HOST=""
FROM_BLOCK=7223888
HEADLESS_SEED_DEFAULT=
HEADLESS_NETWORK=testnet
HEADLESS_SERVER=https://node1.testnet.hathor.network/v1a/
# Where proof of work is submitted. Required, with no default: without it the
# federator starts and then cannot broadcast anything it signs.
HEADLESS_TX_MINING_URL=https://txmining.testnet.hathor.network/
HEADLESS_MULTISIG_SEED_DEFAULT_NUM_SIGNATURES=7
HEADLESS_MULTISIG_SEED_DEFAULT_PUBKEYS=
HATHOR_STATE_CONTRACT_HOST_URL=""
HATHOR_STATE_CONTRACT_ADDR=""
FEDERATION_CHAIN_ID=421614
FEDERATION_FROM_BLOCK=105291988
FEDERATOR_ADDRESS=""
FEDERATION_CONFIRMATION_BLOCKS=4
HATHOR_LAST_TIMESTAMP=1733509177
# Milliseconds - it goes straight into a timer. The previous example here said `1`, which is one
# millisecond, i.e. no input lock at all. 1800000 is 30 minutes, the value production runs.
HATHOR_INPUT_LOCK_TTL_MS=1800000

# Rollout only: set both to run the federator against a wallet container instead of the embedded
# library. Leave unset for normal operation. See the README.
HATHOR_HEADLESS_URL=
HATHOR_HEADLESS_API_KEY=

# Grafana Cloud - only needed if you opt into docker-compose.alloy.yml instead of the default
# docker-compose.yml. See alloy/config.alloy for what each of these is used for.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=
