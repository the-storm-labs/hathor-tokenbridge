# Environment contract for the rearchitected federator (app/ tree).
# Every variable here is declared in app/config/schema.ts and validated at boot: a missing or
# malformed one fails immediately, by name, instead of surfacing as `undefined` further in.
#
# Migrating from the old configuration? See CONFIG_MIGRATION.md for the full old -> new mapping.

# ---- EVM chain: Bridge / Federation / AllowTokens -------------------------------------------
EVM_NAME=arbitrum
EVM_CHAIN_ID=42161
EVM_HOST=https://arb1.arbitrum.io/rpc
EVM_BRIDGE_ADDRESS=
EVM_FEDERATION_ADDRESS=
EVM_ALLOW_TOKENS_ADDRESS=
EVM_FROM_BLOCK=0
# Optional, default 15000
#EVM_BLOCK_TIME_MS=15000

# ---- State chain: the HathorFederation coordination contract ---------------------------------
# May be the same chain as the EVM one above; it is configured separately because it need not be.
STATE_CHAIN_ID=42161
STATE_CHAIN_HOST=https://arb1.arbitrum.io/rpc
STATE_CONTRACT_ADDRESS=
STATE_FROM_BLOCK=0
STATE_CONFIRMATION_BLOCKS=4

# ---- Hathor -----------------------------------------------------------------------------------
HATHOR_NAME=hathor
# Synthetic id keying Hathor in the bridge's token maps - not a real EVM chain id.
HATHOR_CHAIN_ID=31
HATHOR_NETWORK=mainnet
HATHOR_FULLNODE_URL=https://node1.mainnet.hathor.network/v1a/
HATHOR_TX_MINING_URL=https://txmining.mainnet.hathor.network/

# The multisig seed words. NOTE: with the wallet-lib integration this lives in the federator
# process itself, where previously the federator held only an API key for the headless wallet.
HATHOR_SEED=

# Every participant's xpub, comma separated, in the order the multisig was created with.
HATHOR_MULTISIG_PUBKEYS=
# Signatures required to redeem. Was HEADLESS_MULTISIG_SEED_DEFAULT_NUM_SIGNATURES.
HATHOR_NUM_SIGNATURES=
# This federator's 1-based position. Only order 1 creates proposals; the others only sign.
HATHOR_MULTISIG_ORDER=1

HATHOR_MIN_CONFIRMATIONS=1
# Optional, default 20. The lever deciding how much history an address scan walks.
#HATHOR_GAP_LIMIT=20

# How long a UTXO stays marked as selected-as-input, in MILLISECONDS - the value goes straight
# into setTimeout. Was HATHOR_INPUT_BLOCK_TTL, whose shipped example value of `1` meant one
# millisecond, i.e. no lock at all. 1800000 is 30 minutes, the value production actually runs.
HATHOR_INPUT_LOCK_TTL_MS=1800000

# Unix seconds to replay Hathor history from when no cursor has been persisted yet.
HATHOR_FROM_TIMESTAMP=

# Transitional - only the headless HTTP adapter reads these, so that its behaviour can be compared
# against the wallet-lib adapter. Both or neither. Removed along with the container.
#HATHOR_HEADLESS_URL=http://hathor-wallet:8000
#HATHOR_HEADLESS_API_KEY=

# ---- Federator identity -----------------------------------------------------------------------
FEDERATOR_KEY=
# Optional. When set it is checked against the address derived from FEDERATOR_KEY, never trusted.
#FEDERATOR_ADDRESS=

# ---- Runtime ----------------------------------------------------------------------------------
#STORAGE_PATH=./db
#ENDPOINTS_PORT=5000
#POLLING_INTERVAL_MS=45000
#FEDERATOR_RETRIES=3
#REQUIRE_HTTPS=true
#ETHERSCAN_KEY=
#EXPLORER_URL=
