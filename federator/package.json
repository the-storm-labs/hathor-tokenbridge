{
  "name": "federator",
  "private": "true",
  "version": "3.0.0",
  "description": "RSK Bridge Federator",
  "keywords": [
    "rsk",
    "federated",
    "bridge",
    "ethereum",
    "federator"
  ],
  "author": "IOVLabs",
  "scripts": {
    "start": "node ./built/federator/src/main.js",
    "start-dev": "npx ts-node ./src/main.ts",
    "build": "npx tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "clean": "rm -rf ./db/* ./built",
    "inspect:proposals": "npx ts-node ./src/scripts/inspectProposals.ts",
    "advance:transfer": "npx ts-node ./src/scripts/advanceTransfer.ts"
  },
  "dependencies": {
    "@hathor/wallet-lib": "^4.1.0",
    "axios": "^1.8.2",
    "dotenv": "^16.0.1",
    "express": "^4.17.1",
    "log4js": "^6.9.1",
    "prom-client": "^15.1.3",
    "web3": "^4.16.0",
    "web3-eth-accounts": "^4.3.1",
    "web3-utils": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-typescript": "^7.15.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^29.7.0",
    "node-notifier": "^8.0.1",
    "nodemon": "^3.1.9",
    "prettier": "^2.8.8",
    "tar": ">=4.4.18",
    "tmpl": "^1.0.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^4.3.5",
    "web3-core-promievent": "^1.2.11"
  },
  "resolutions": {
    "axios": "^0.21.2",
    "tar": ">=4.4.18"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "22"
  }
}
